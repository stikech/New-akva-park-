# Скопируйте в backend/.env и заполните. Все переменные необязательны.

# Порт и адрес
PORT=3000
HOST=0.0.0.0

# Токен для страницы /admin (длинная случайная строка). Пусто — админка выключена.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Секрет подписи чеков оплаты (HMAC-SHA256). Пусто — генерируется при каждом запуске,
# тогда подписи чеков «протухнут» после перезапуска. Для продакшена задайте постоянный:
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_SECRET=

# Оплата: kaspi (по умолчанию) или demo — эмулятор карт только для тестов, на боевом сайте НЕ включать
PAYMENT_MODE=kaspi
# Перевод на банковскую карту (иначе берётся из backend/payment.config.js)
PAY_CARD_NUMBER=
PAY_CARD_BANK=
PAY_CARD_HOLDER=

# Оплата картой на сайте через TipTop Pay: Public ID и API Secret из личного кабинета tiptoppay.kz
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=

# Сотрудники для /admin: Имя:пароль через точку с запятой (пароль от 8 символов)
STAFF_LOGINS=

# Реквизиты Kaspi (иначе берутся из backend/payment.config.js)
KASPI_PHONE=
KASPI_RECEIVER=
KASPI_PAY_LINK=
KASPI_QR=

# Облачная копия данных (Upstash Redis → Database → REST API). Пусто — только локальные файлы.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Адрес сайта для ссылок в Telegram (на Render задаётся сам)
PUBLIC_URL=

# Демо-аккаунты личного кабинета: 1 — создавать при запуске (пароль neptun2026), пусто — нет
DEMO_ACCOUNTS=1

# Уведомления о новых отзывах в Telegram (см. README → «Уведомления в Telegram»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Папка для feedback.jsonl (по умолчанию backend/data)
DATA_DIR=

# Сколько прокси перед сервером: 0 — локально, 1 — Render / nginx
TRUST_PROXY=0

# Лимит отзывов с одного IP: не больше N за M минут
FEEDBACK_RATE_MAX=5
FEEDBACK_RATE_WINDOW_MIN=10
